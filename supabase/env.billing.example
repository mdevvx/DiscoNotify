# Secrets for supabase/functions/billing (unsubscribe links + maintenance banner only).
# Copy to supabase/.env.billing (gitignored). Never commit values.
#
# Push:   npx supabase secrets set --env-file supabase/.env.billing
# Deploy: npx supabase functions deploy billing --no-verify-jwt --use-api
#
# SUPABASE_URL and the service key are provided by Supabase automatically.

SITE_URL=https://disconotify.com
# Optional extra origins, comma separated (e.g. http://localhost:3000 while developing)
ALLOWED_ORIGINS=

# Same long random string as the bot's BILLING_LINK_SECRET
BILLING_LINK_SECRET=
