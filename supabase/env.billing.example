# Secrets for supabase/functions/billing. Copy this file to:
#   supabase/.env.billing.sandbox   (sandbox tokens, *_SANDBOX=true)
#   supabase/.env.billing.live      (production tokens, *_SANDBOX=false)
# Those real files are gitignored. Never commit values.
#
# Push:   npx supabase secrets set --env-file supabase/.env.billing.sandbox
# Deploy: npx supabase functions deploy billing --no-verify-jwt --use-api
# Local:  npx supabase functions serve billing --env-file supabase/.env.billing.sandbox
#
# SUPABASE_URL and the service key are provided by Supabase automatically (do not add them; names starting
# with SUPABASE_ are rejected by `secrets set`).

SITE_URL=https://disconotify.com
# Optional extra origins, comma separated (e.g. http://localhost:3000 while developing)
ALLOWED_ORIGINS=
# Optional: where Polar sends buyers after paying. Must be on SITE_URL or ALLOWED_ORIGINS.
POLAR_SUCCESS_URL=

# Same long random string as the bot's BILLING_LINK_SECRET
BILLING_LINK_SECRET=
# A second, different long random string
SESSION_SECRET=

POLAR_WEB_TOKEN=
POLAR_PRODUCT_ID=
# true = sandbox.polar.sh, false = live. Must match the bot.
POLAR_SANDBOX=false

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

NOWPAYMENTS_API_KEY=
# true = NOWPayments sandbox, false = live. Must match the bot.
NOWPAYMENTS_SANDBOX=false

# Equal to the bot's settings
BILLING_PRICE_USD=1.99
BILLING_TRIAL_DAYS=7
BILLING_GRACE_DAYS=3
