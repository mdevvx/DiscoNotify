# Copy to .env.local (or set in Netlify / GitHub Actions) and fill in.
# These values are baked into the static site at build time.

NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_DISCORD_CLIENT_ID=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_SERVER=

# Your exact legal name (company, or your full name as a sole proprietor) and address, required by your payment provider
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
# Billing function URL after `supabase functions deploy billing` (see README)
NEXT_PUBLIC_BILLING_API_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/billing
# Optional: your Polar customer portal link, shown on the Manage page
NEXT_PUBLIC_POLAR_PORTAL_URL=

# Everything secret (Polar token, Discord client secret, link and session secrets, NOWPayments key)
# goes into Supabase secrets, never into this file. See README.
